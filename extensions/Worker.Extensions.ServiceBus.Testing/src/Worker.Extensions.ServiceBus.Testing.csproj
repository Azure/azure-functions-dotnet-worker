<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Microsoft.Azure.Functions.Worker.Extensions.ServiceBus.Testing</PackageId>
    <Description>Service Bus trigger integration testing for Azure Functions .NET isolated worker applications.</Description>
    <AssemblyName>Microsoft.Azure.Functions.Worker.Extensions.ServiceBus.Testing</AssemblyName>
    <RootNamespace>Microsoft.Azure.Functions.Worker.Extensions.ServiceBus.Testing</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <MajorProductVersion>1</MajorProductVersion>
    <MinorProductVersion>0</MinorProductVersion>
    <PatchProductVersion>0</PatchProductVersion>
    <VersionSuffix>-preview.1</VersionSuffix>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <Import Project="../../../build/Common.props" />
  <Import Project="../../../build/WorkerTestingCompatibility.props" />
  <Import Project="../../../build/WorkerTestingPack.targets" />

  <ItemGroup>
    <ProjectReference Include="../../Worker.Extensions.ServiceBus/src/Worker.Extensions.ServiceBus.csproj"
                      Version="[$(WorkerTestingCompatibleServiceBusVersion)]" />
    <ProjectReference Include="../../../src/DotNetWorker.Testing/DotNetWorker.Testing.csproj"
                      Version="[$(WorkerTestingCompatibleCorePackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(_WorkerTestingGeneratedCompatibilityProps)"
          Pack="true"
          PackagePath="buildTransitive/Microsoft.Azure.Functions.Worker.Extensions.ServiceBus.Testing.props" />
  </ItemGroup>

</Project>
