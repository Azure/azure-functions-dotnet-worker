<!--
***********************************************************************************************
Azure.Functions.Publish.targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
          created a backup copy.  Incorrect changes to this file will make it
          impossible to load or build your projects from the command-line or the IDE.

***********************************************************************************************
-->

<Project>

  <Import Project="$(MSBuildThisFileDirectory)Azure.Functions.Sdk.Publish.$(PublishProtocol).targets"
          Condition="Exists('$(MSBuildThisFileDirectory)Azure.Functions.Sdk.Publish.$(PublishProtocol).targets')" />

  <PropertyGroup>
    <PublishContainerDependsOn>$(PublishContainerDependsOn);_RemoveWorkerConfigFromStandaloneContainer</PublishContainerDependsOn>
    <_FunctionsTargetFrameworkVersion>$(TargetFrameworkVersion.TrimStart('vV'))</_FunctionsTargetFrameworkVersion>
    <!-- .NET 11 and later default to the Chiseled host image, which does not include the worker's runtime. -->
    <_FunctionsSupportsChiseledContainer Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(_FunctionsTargetFrameworkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(_FunctionsTargetFrameworkVersion)', '11.0'))">true</_FunctionsSupportsChiseledContainer>
    <_FunctionsChiseledBaseImage>mcr.microsoft.com/azure-functions/dotnet-isolated:$(_FunctionsRuntimeMajorVersion)-dotnet-isolated$(_FunctionsTargetFrameworkVersion)-chiseled</_FunctionsChiseledBaseImage>
  </PropertyGroup>

  <Target Name="ValidateFunctionsContainerMode">
    <Error Text="Invalid FunctionsContainerMode '$(FunctionsContainerMode)'. Supported values are 'HostEmbedded' and 'Standalone'."
           Condition="'$(FunctionsContainerMode)' != 'HostEmbedded' and '$(FunctionsContainerMode)' != 'Standalone'" />
  </Target>

  <!--
    ComputeContainerBaseImage will set the default 'ContainerRuntimeIdentifier' if not already set, so must run after
    that. We do not set ContainerRuntimeIdentifier ourselves, but check it is a correct value. The default container
    RID will be either set to the explicit RID for the build, or for portable it becomes linux-[machine-arch]. In
    either of these cases, we validate that it became linux-x64. Which means that either the publish was performed for
    linux-x64, or it is portable from an x64 machine. If the user explicitly sets Container RID to linux-x64, but
    regular RID to something else, we will trust they know best.
  -->
  <Target Name="ValidateFunctionsContainerRuntimeIdentifier" AfterTargets="ComputeContainerBaseImage">
    <Error Text="Multi-architecture containers are not supported. Azure Functions containers only support linux-x64."
           Condition="'$(ContainerRuntimeIdentifier)' == '' and '$(ContainerRuntimeIdentifiers)' != ''" />
    <Error Text="Invalid ContainerRuntimeIdentifier '$(ContainerRuntimeIdentifier)'. Azure Functions containers only support linux-x64."
           Condition="'$(ContainerRuntimeIdentifier)' != '' and '$(ContainerRuntimeIdentifier)' != 'linux-x64'" />
  </Target>


  <!--
    Standalone containers do not need worker.config.json. Since PublishContainer always runs a Publish beforehand, we
    do not expect this PublishDir to be re-usable for any other scenario without another non-container publish ran (in
    which case worker.config.json is recreated).
  -->
  <Target Name="_RemoveWorkerConfigFromStandaloneContainer"
          Condition="'$(FunctionsContainerMode)' == 'Standalone'">
    <Delete Files="$(PublishDir)$(_WorkerConfigFileName)" />
  </Target>

  <Target Name="ComputeFunctionsContainerConfig" BeforeTargets="ComputeContainerBaseImage"
          DependsOnTargets="ValidateFunctionsContainerMode;AssignFunctionsBaseImage">
    <ItemGroup>
      <ContainerLabel Include="com.azure.functions.sdk" Value="$(AzureFunctionsSdkVersion)" />
    </ItemGroup>
  </Target>

  <Target Name="AssignFunctionsBaseImage" Condition="'$(FunctionsContainerMode)' == 'HostEmbedded'">
    <PropertyGroup>
      <_FunctionsUseChiseledContainer Condition="'$(_FunctionsSupportsChiseledContainer)' == 'true' and ('$(ContainerBaseImage)' == '' or '$(ContainerBaseImage)' == '$(_FunctionsChiseledBaseImage)')">true</_FunctionsUseChiseledContainer>
      <ContainerBaseImage Condition="'$(ContainerBaseImage)' == '' and '$(_FunctionsUseChiseledContainer)' == 'true'">$(_FunctionsChiseledBaseImage)</ContainerBaseImage>
      <ContainerBaseImage Condition="'$(ContainerBaseImage)' == ''">mcr.microsoft.com/azure-functions/dotnet-isolated:$(_FunctionsRuntimeMajorVersion)-dotnet-isolated$(_FunctionsTargetFrameworkVersion)</ContainerBaseImage>
      <ContainerWorkingDirectory Condition="'$(ContainerWorkingDirectory)' == ''">/home/site/wwwroot</ContainerWorkingDirectory>
      <ContainerUser Condition="'$(_FunctionsUseChiseledContainer)' == 'true' and '$(ContainerUser)' == ''">0</ContainerUser>
      <ContainerAppCommandInstruction Condition="'$(_FunctionsUseChiseledContainer)' == 'true' and '$(ContainerAppCommandInstruction)' == '' and '@(ContainerAppCommand)' == '' and '@(ContainerAppCommandArgs)' == ''">None</ContainerAppCommandInstruction>
    </PropertyGroup>

    <ItemGroup>
      <ContainerAppCommand Include="/azure-functions-host/Microsoft.Azure.WebJobs.Script.WebHost"
        Condition="'$(_FunctionsUseChiseledContainer)' == 'true' and '$(ContainerAppCommandInstruction)' != 'None' and '@(ContainerAppCommand)' == ''" />
      <ContainerAppCommand Include="/opt/startup/start_nonappservice.sh"
        Condition="'$(_FunctionsUseChiseledContainer)' != 'true' and ('$(_FunctionsSupportsChiseledContainer)' != 'true' or ('@(ContainerAppCommand)' == '' and '$(ContainerAppCommandInstruction)' != 'None'))" />
      <ContainerEnvironmentVariable Include="AzureWebJobsScriptRoot" Value="$(ContainerWorkingDirectory)"
        Condition="!@(ContainerEnvironmentVariable->AnyHaveMetadataValue('Identity', 'AzureWebJobsScriptRoot'))"/>
      <ContainerEnvironmentVariable Include="AzureFunctionsJobHost__Logging__Console__IsEnabled" Value="true"
        Condition="!@(ContainerEnvironmentVariable->AnyHaveMetadataValue('Identity', 'AzureFunctionsJobHost__Logging__Console__IsEnabled'))"/>
    </ItemGroup>
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)Azure.Functions.Sdk.Publish.Chiseled.targets"
          Condition="'$(_FunctionsSupportsChiseledContainer)' == 'true' and '$(FunctionsContainerMode)' == 'HostEmbedded'" />

</Project>
