<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <TargetFramework>$(_FunctionsContainerTargetFramework)</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <OutputType>Exe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(_FunctionsAspNetRuntimeVersion)' != ''" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(_FunctionsCoreRuntimeVersion)" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="$(_FunctionsAspNetRuntimeVersion)" />
  </ItemGroup>

  <Target Name="GetFunctionsContainerRuntimePacks"
          DependsOnTargets="ProcessFrameworkReferences;ResolveFrameworkReferences"
          Returns="@(ResolvedRuntimePack)" />
</Project>
